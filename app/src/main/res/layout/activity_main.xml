<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step Counter"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintBottom_toTopOf="@+id/stepCountText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/stepCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="72sp"
        android:textStyle="bold"
        android:textColor="@color/purple_500"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toTopOf="@+id/stepsLabelText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleText" />

    <TextView
        android:id="@+id/stepsLabelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="steps today"
        android:textSize="18sp"
        android:textColor="@color/gray_600"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/refreshButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stepCountText" />

    <Button
        android:id="@+id/refreshButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Refresh Steps"
        android:textSize="16sp"
        android:layout_marginTop="48dp"
        android:backgroundTint="@color/purple_500"
        app:layout_constraintBottom_toTopOf="@+id/lastUpdatedText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stepsLabelText" />

    <TextView
        android:id="@+id/lastUpdatedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap refresh to load steps"
        android:textSize="14sp"
        android:textColor="@color/gray_500"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@+id/coachFeedbackCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/refreshButton" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/coachFeedbackCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/purple_200"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lastUpdatedText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/coachTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💪 Coach Feedback"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple_700" />

                <ImageButton
                    android:id="@+id/playVoiceButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_media_play"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play voice feedback"
                    android:scaleType="centerInside"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/debugButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test Random"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/testOpenAIButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test OpenAI"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp" />

                <Button
                    android:id="@+id/testAPIRandomButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test API Random"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/coachFeedbackText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading motivational feedback..."
                android:textSize="14sp"
                android:textColor="@color/black"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
